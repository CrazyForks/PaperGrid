# Database
DATABASE_URL="file:./dev.db"
# Optional: dedicated SQLite file for AI vector index (recommended in production)
# AI_VECTOR_DATABASE_URL="file:/data/ai-index.sqlite"
# Optional: SQLite journal mode used by AI vector index module
# Stable default is DELETE; set WAL only when storage is confirmed stable
# SQLITE_JOURNAL_MODE="DELETE"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Local media storage
MEDIA_ROOT=".local/uploads"
MEDIA_MAX_UPLOAD_MB="10"
MEDIA_MAX_INPUT_PIXELS="12000000"
MEDIA_RESOLVE_CACHE_TTL_MS="30000"

# Bootstrap creates a random administrator password if no admin exists.
# Docker: /data/initial-admin.txt; development: .local/initial-admin.txt
# ADMIN_INIT_PASSWORD: optional 12–72 byte password. INIT_ADMIN_TOKEN is optional.
INIT_ADMIN_TOKEN=""
ADMIN_INIT_PASSWORD=""

# GitHub OAuth (Get from: https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (Get from: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email Notifications (SMTP)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# Comma-separated recipients. If empty, the system will send to all admin emails.
EMAIL_TO=""
# Optional denylist for reply notifications (comma/newline separated)
EMAIL_REPLY_DENYLIST=""
# Optional signing secret for unsubscribe links (fallbacks to NEXTAUTH_SECRET)
EMAIL_UNSUBSCRIBE_SECRET=""
# Token expiration days for unsubscribe link
EMAIL_REPLY_UNSUBSCRIBE_EXPIRE_DAYS="365"

# Gotify (Optional - for notifications)
GOTIFY_URL=""
GOTIFY_TOKEN=""

# AI (Optional - OpenAI-compatible)
AI_OPENAI_API_KEY=""
# Optional fallback, if not configured in admin AI settings
OPENAI_API_KEY=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="zh"
# Optional: override logger level (fatal/error/warn/info/debug/trace/silent)
# LOG_LEVEL="info"

# Custom Head Injection – CSP allowlist
# Comma-separated origins for external scripts added via admin "custom head code".
# Example: HEAD_INJECT_SCRIPT_ORIGINS="https://stats.xywml.com,https://www.googletagmanager.com"
HEAD_INJECT_SCRIPT_ORIGINS=""
# Optional compatibility switch: keep legacy script-src 'unsafe-inline' (default true)
# Set to false after confirming no inline scripts are required by your deployment.
# CSP_ALLOW_UNSAFE_INLINE_SCRIPT="false"

# Only trust one header set/overwritten by your own reverse proxy.
# Empty: ignore client-supplied IP headers. Nginx: x-real-ip. Direct CF: cf-connecting-ip.
TRUSTED_PROXY_HEADER=""
# Runtime heap budget (Docker already applies this default)
# NODE_OPTIONS="--max-old-space-size=160 --max-semi-space-size=2"
