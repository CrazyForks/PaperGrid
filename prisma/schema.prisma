// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// NextAuth Models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials login
  role          Role      @default(USER)
  sessionVersion Int      @default(0)
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  mediaFiles    MediaFile[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Blog Models
// ============================================

enum Role {
  USER
  ADMIN
}


enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  posts     PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  url         String
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model PostTag {
  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
  tag      Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String

  @@id([postId, tagId])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String     // MDX content
  excerpt     String?
  coverImage  String?
  status      PostStatus @default(DRAFT)
  locale      String     @default("zh") // zh or en
  publishedAt DateTime?
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  category    Category?  @relation(fields: [categoryId], references: [id])
  categoryId  String?
  postTags    PostTag[]
  comments    Comment[]
  viewCount   ViewCount?
  dailyViews  DailyView[]
  mediaReferences PostMedia[]
  analytics   Analytics?
  readingTime Int?       // in minutes
  isProtected Boolean    @default(false)
  passwordHash String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([locale])
  @@index([status, publishedAt, id])
  @@index([status, categoryId, publishedAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorName String?  // For guest comments
  authorEmail String? // For guest comments
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  replies   Comment[] @relation("CommentReplies")
  status    CommentStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([status])
  @@index([postId, status, createdAt, id])
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
  REJECTED
}

enum MediaCompressionMode {
  ORIGINAL
  BALANCED
  HIGH
}

model MediaFile {
  id              String               @id @default(cuid())
  postReferences PostMedia[]
  private         Boolean              @default(false)
  originalName    String
  storagePath     String               @unique
  mimeType        String
  ext             String
  size            Int
  width           Int?
  height          Int?
  sha256          String?
  compressionMode MediaCompressionMode @default(BALANCED)
  uploadedBy      User?                @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById    String?
  uploadedByApiKeyId String?
  uploadedByApiKey ApiKey? @relation(fields: [uploadedByApiKeyId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  @@index([createdAt])
  @@index([uploadedById])
  @@index([uploadedByApiKeyId])
}

model ViewCount {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyView {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  date      DateTime
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, postId])
  @@index([date])
  @@index([postId])
}

model Analytics {
  id                String   @id @default(cuid())
  post              Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId            String?  @unique
  views             Int      @default(0)
  uniqueVisitors    Int      @default(0)
  avgReadingTime    Float?   // in minutes
  bounceRate        Float?   // percentage
  date              DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ApiKey {
  id          String            @id @default(cuid())
  name        String
  keyHash     String            @unique
  keyPrefix   String
  createdById String?
  permissions Json
  enabled     Boolean           @default(true)
  lastUsedAt  DateTime?
  lastUsedIp  String?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  uploads     MediaFile[]
  idempotencyRequests ApiIdempotency[]

  @@index([keyPrefix])
  @@index([enabled])
  @@index([createdById])
  @@index([expiresAt])
}

model ApiIdempotency {
  id          String   @id @default(cuid())
  apiKeyId    String
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  operation   String
  keyHash     String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([apiKeyId, operation, keyHash])
  @@index([expiresAt])
}

// 系统设置
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  group       String   @default("site")
  editable    Boolean  @default(true)
  secret      Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
}

// Explicit references support privacy checks and bounded file-use queries.
model PostMedia {
  postId String
  mediaId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@id([postId, mediaId])
  @@index([mediaId])
}
